{
  "name": "@oss-scout/mcp",
  "version": "0.13.0",
  "description": "MCP server for oss-scout — exposes issue discovery and vetting as MCP tools",
  "type": "module",
  "bin": {
    "oss-scout-mcp": "./dist/mcp-server.bundle.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/bin.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/mcp-server.bundle.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@oss-scout/core": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.5",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "issue-discovery"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/costajohnt/oss-scout.git",
    "directory": "packages/mcp-server"
  }
}
